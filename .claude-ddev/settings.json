{
  "permissions": {
    "allow": [
      "Bash",
      "WebFetch",
      "mcp__plugin_figma_figma__get_design_context",
      "mcp__plugin_figma_figma__get_variable_defs",
      "mcp__plugin_figma_figma__get_metadata",
      "mcp__plugin_figma_figma__get_screenshot",
      "mcp__plugin_figma_figma__get_figjam",
      "mcp__plugin_figma_figma__get_motion_context",
      "mcp__plugin_figma_figma__get_libraries",
      "mcp__plugin_figma_figma__search_design_system",
      "mcp__plugin_figma_figma__whoami",
      "mcp__plugin_figma_figma__get_code_connect_map",
      "mcp__plugin_figma_figma__get_code_connect_suggestions",
      "mcp__plugin_figma_figma__get_context_for_code_connect",
      "mcp__plugin_figma_figma__list_file_components_for_code_connect",
      "mcp__plugin_figma_figma__download_assets"
    ],
    "ask": [
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(telnet:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(sftp:*)",
      "Bash(ftp:*)"
    ],
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x /opt/kokoro/bin/python ] && /opt/kokoro/bin/python \"$CLAUDE_CONFIG_DIR/speech/speak.py\" 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x /opt/kokoro/bin/python ] && /opt/kokoro/bin/python \"$CLAUDE_CONFIG_DIR/speech/speak.py\" --stop >/dev/null 2>&1 || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$CLAUDE_CONFIG_DIR/statusline-command.sh\""
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "craftcms-claude-skills@craftcms-claude-skills": true
  },
  "extraKnownMarketplaces": {
    "craftcms-claude-skills": {
      "source": {
        "source": "github",
        "repo": "michtio/craftcms-claude-skills"
      }
    }
  },
  "outputStyle": "Concise",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "tui": "fullscreen",
  "theme": "dark",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true
}
