{# =============================================================== #}
{# Global Header
{# =============================================================== #}
{#
  {% include '_partials/global-header' %}
#}

{% set navNodes = craft.navigation.nodes('primary').level(1).with(['children']).all() %}

<header class="global-header" data-module-global-header>
  <div class="global-header__inner">

    {# Logo #}
    <div class="global-header__logo">
      {% include '_partials/logo-horizontal' %}
    </div>

    {# Nav #}
    <div class="global-header__nav">
      {# Full Nav #}
      <div class="global-header__nav-full">
        {% for node in navNodes %}
          {% include '_partials/primary-nav-item' with {
            node: node,
          } only %}
        {% endfor %}
      </div>

      {# Mobile Nav #}
      <div class="global-header__nav-mobile">
        {# Toggle #}
        <div class="global-header__toggle">
          {% include '_partials/global-nav-toggle' with {
            label: 'Menu',
            action: 'open',
            key: 'dialog-global-nav',
          } %}
        </div>
      </div>
    </div>

  </div>
</header>

{# Dialog #}
{% include '_partials/dialog-global-nav' with {
  key: 'dialog-global-nav',
} only %}

